{
  "name": "codi-web-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "npm --prefix projects/admin run start --",
    "build": "node scripts/build.mjs",
    "watch": "ng build web.admin --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm audit",
    "audit:runtime": "npm audit --omit=dev",
    "start:admin": "npm --prefix projects/admin run start --",
    "start:frontend": "npm --prefix projects/public run start --",
    "build:admin": "ng build web.admin",
    "build:frontend": "ng build web.frontend",
    "test:admin": "ng test web.admin",
    "test:frontend": "ng test web.frontend"
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "overrides": {
    "minimatch": "11.0.8",
    "@spartan-ng/cli": {
      "zod": "4.6.6"
    },
    "nx": {
      "axios": "1.20.0",
      "brace-expansion": "5.0.12",
      "smol-toml": "1.9.0"
    }
  },
  "dependencies": {
    "@angular/cdk": "22.2.1",
    "@angular/common": "~22.2.6",
    "@angular/compiler": "~22.2.6",
    "@angular/core": "~22.2.6",
    "@angular/forms": "~22.2.6",
    "@angular/platform-browser": "~22.2.6",
    "@angular/router": "~22.2.6",
    "@microsoft/signalr": "10.0.11",
    "@ng-icons/core": "36.1.0",
    "@ng-icons/lucide": "36.1.0",
    "@spartan-ng/brain": "1.5.0",
    "blockly": "^13.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "3.7.0",
    "three": "^0.187.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.6",
    "@angular/cli": "~22.2.6",
    "@angular/compiler-cli": "~22.2.6",
    "@eslint/js": "^10.0.1",
    "@spartan-ng/cli": "1.5.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/three": "^0.187.0",
    "angular-eslint": "^22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": ">=27.4.0 <30.0.0",
    "postcss": "8.5.28",
    "prettier": "^3.8.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  }
}
