      "@spartan-ng/helm/label": ["./projects/admin/src/app/ui/label/src/index.ts"],
      "@spartan-ng/helm/card": ["./projects/admin/src/app/ui/card/src/index.ts"],
      "@spartan-ng/helm/sidebar": ["./projects/admin/src/app/ui/sidebar/src/index.ts"],
