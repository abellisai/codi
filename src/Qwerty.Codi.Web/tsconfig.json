      "@spartan-ng/helm/native-select": ["./projects/admin/src/app/ui/native-select/src/index.ts"],
      "@spartan-ng/helm/textarea": ["./projects/admin/src/app/ui/textarea/src/index.ts"],
      "@spartan-ng/helm/empty": ["./projects/admin/src/app/ui/empty/src/index.ts"],
      "@spartan-ng/helm/table": ["./projects/admin/src/app/ui/table/src/index.ts"],
      "@spartan-ng/helm/pagination": ["./projects/admin/src/app/ui/pagination/src/index.ts"],
      "@spartan-ng/helm/select": ["./projects/admin/src/app/ui/select/src/index.ts"],
