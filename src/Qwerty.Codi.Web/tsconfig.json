      "@spartan-ng/helm/alert-dialog": ["./projects/admin/src/app/ui/alert-dialog/src/index.ts"],
      "@spartan-ng/helm/sonner": ["./projects/admin/src/app/ui/sonner/src/index.ts"],
      "@spartan-ng/helm/badge": ["./projects/admin/src/app/ui/badge/src/index.ts"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
