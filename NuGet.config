<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Tutti i pacchetti NuGet della soluzione vengono ripristinati dentro la cartella del
       progetto, non nel profilo utente. Il percorso relativo è risolto rispetto a questo
       file (radice della soluzione) e la cartella `packages` viene creata al primo restore.
       Lo stesso valore è ripetuto in Directory.Build.props (RestorePackagesPath) per coprire
       anche i ripristini MSBuild: i due valori devono restare identici.
       Le origini pacchetti ereditate dalla configurazione di macchina restano invariate:
       qui non si usa <clear/> sulle sorgenti, solo il percorso di ripristino. -->
  <config>
    <add key="globalPackagesFolder" value="packages" />
  </config>
</configuration>
